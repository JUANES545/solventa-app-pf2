<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Solventa" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#F7F9FC</item>
    </style>
    <style name="Theme.Solventa.Starting.Base" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/solventa_launch_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/solventa_brand</item>
        <item name="postSplashScreenTheme">@style/Theme.Solventa</item>
        <item name="android:statusBarColor">@color/solventa_launch_background</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">@bool/solventa_launch_light_bars</item>
    </style>
    <style name="Theme.Solventa.Starting" parent="Theme.Solventa.Starting.Base" />
</resources>
