[Unit]
Description=Start and stop the fixed Solventa Android agent
After=jenkins.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/jenkins-pilot/read-credentials.json

[Service]
Type=oneshot
User=jenkins-lifecycle
Group=jenkins-lifecycle
EnvironmentFile=/etc/jenkins-pilot/lifecycle.env
ExecStart=/usr/bin/python3 /opt/jenkins-pilot/agent-lifecycle.py
StateDirectory=jenkins-pilot
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
